{
  "_comment": "Copy to config/local.settings.json (gitignored). Run 'origo-bc-mcp-server setup' for guided configuration, or use the dashboard at /dashboard/setup.",
  "basicAuth": {
    "enabled": true,
    "username": "dev",
    "password": "change-me"
  },
  "_devConnection_onprem_example": {
    "onPrem": true,
    "baseUrl": "https://<host>:443/<instance>rest",
    "developerBaseUrl": "https://<host>:443/<instance>dev",
    "onPremTenant": "default",
    "user": "<bc-web-service-user>",
    "key": "<bc-web-service-access-key | env:VAR_NAME | dpapi:base64 | aes:base64>",
    "companyId": "<company-guid>",
    "companyName": "OnPrem",
    "environment": "onprem"
  },
  "_devConnection_native_bc_example": {
    "_comment": "Native (non-container) multitenant BC on the MCP host. bc_dev_run_tests mode=local (auto picks it) uses clientServicesUrl + testAssembliesPath; paths are as seen by the MCP process.",
    "onPrem": true,
    "baseUrl": "http://host.docker.internal:7048/BC290/api/v2.0",
    "developerBaseUrl": "http://host.docker.internal:7049/BC290/dev",
    "clientServicesUrl": "http://host.docker.internal:8080/BC290/",
    "testAssembliesPath": "/mcp-runtime/bc29-test-assemblies",
    "onPremTenant": "w129-01",
    "user": "<bc-user>",
    "key": "<bc-password | env:VAR_NAME | aes:base64>",
    "companyName": "CRONUS International Ltd.",
    "environment": "onprem"
  },
  "_devConnection_saas_example": {
    "tenantId": "<entra-tenant-guid>",
    "clientId": "<app-client-id>",
    "clientSecret": "<client-secret | env:VAR_NAME | dpapi:base64 | aes:base64 | keychain:service>",
    "refreshToken": "<refresh-token | env:VAR_NAME | dpapi:base64 | aes:base64 | keychain:service>",
    "environment": "UAT",
    "companyId": "<company-guid>"
  },
  "devConnection": {
    "_comment": "The default connection (used when no ?connection= param is specified)",
    "onPrem": true,
    "baseUrl": "https://<host>:443/<instance>rest",
    "developerBaseUrl": "https://<host>:443/<instance>dev",
    "onPremTenant": "default",
    "user": "<bc-web-service-user>",
    "key": "<bc-web-service-access-key>",
    "companyId": "<company-guid>",
    "companyName": "OnPrem",
    "environment": "onprem"
  },
  "connections": {
    "_comment": "Named connections \u2014 select via ?connection=<name> in the MCP URL",
    "production": {
      "tenantId": "<entra-tenant-guid>",
      "clientId": "<app-client-id>",
      "clientSecret": "env:BC_PROD_CLIENT_SECRET",
      "environment": "production",
      "companyId": "<company-guid>"
    },
    "sandbox": {
      "tenantId": "<entra-tenant-guid>",
      "clientId": "<app-client-id>",
      "clientSecret": "env:BC_SANDBOX_CLIENT_SECRET",
      "environment": "sandbox",
      "companyId": "<company-guid>"
    }
  },
  "cosmo": {
    "_comment": "Cosmo Alpaca API for cosmo_* tools. Prefer COSMO_BEARER_TOKEN env over bearerToken here, or set both in /dashboard/setup (COSMO section), which stores the token encrypted as aes:/dpapi: and never shows it again; env vars take precedence over saved values. backendUrl must be the Alpaca API base (.../api/alpaca/release), not the bare public container host.",
    "backendUrl": "https://cosmo-alpaca-enterprise.westeurope.cloudapp.azure.com/api/alpaca/release",
    "bearerToken": "env:COSMO_BEARER_TOKEN"
  }
}
